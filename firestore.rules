rules_version = '2';

// Regras de segurança do Firestore para o Vytal.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /patients/{patientId} {
      // Paciente pode ler, criar e atualizar seu próprio doc
      allow read, create, update: if request.auth != null && request.auth.uid == patientId;
      
      // Nutricionista dono pode ler, atualizar, criar, deletar
      allow read, update, delete: if request.auth != null
        && resource.data.nutricionista_id == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.nutricionista_id == request.auth.uid;

      // Paciente novo pode ler o documento temporário gerado pelo nutri antes de ter conta (ID atua como token de convite)
      allow read: if resource.data.status == 'inativo';
      // Só o próprio paciente reivindicando o convite (uid == patientId) pode apagar o placeholder,
      // nunca outro usuário autenticado qualquer
      allow delete: if request.auth != null
        && request.auth.uid == patientId
        && resource.data.status == 'inativo';
    }

    match /appointments/{apptId} {
      allow read, update, delete: if request.auth != null
        && resource.data.nutricionista_id == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.nutricionista_id == request.auth.uid;
    }

    match /dietTemplates/{templateId} {
      allow read, update, delete: if request.auth != null
        && resource.data.nutricionista_id == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.nutricionista_id == request.auth.uid;
    }

    match /recipes/{recipeId} {
      allow read, update, delete: if request.auth != null
        && resource.data.nutricionista_id == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.nutricionista_id == request.auth.uid;
    }
  }
}
