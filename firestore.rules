rules_version = '2';

// Regras de segurança do Firestore para o Vytal.
service cloud.firestore {
  match /databases/{database}/documents {

    // Campos que SÓ o servidor grava (Admin SDK, que ignora estas regras): os
    // chat ids do Telegram/WhatsApp, gravados pelos webhooks ao resgatar o
    // vínculo. Se o cliente pudesse escrevê-los, qualquer conta apontaria os
    // crons (api/cron-*.js) pro chat de outra pessoa e dispararia mensagens
    // não solicitadas. Mantenha em sincronia com lib/serverOnlyFields.js.
    // Também são só-de-servidor os campos do Radar de Abandono calculados pelo
    // cron (api/cron-risk-scan.js).
    function serverOnlyKeys() {
      return [
        'telegram_chat_id', 'telegram_linked_at', 'whatsapp_chat_id', 'whatsapp_linked_at',
        'riskScore', 'riskLevel', 'riskFactors', 'lastRiskNotifiedLevel', 'lastRiskNotifiedAt'
      ];
    }
    // Só o nutricionista dono grava a correção manual do risco; o paciente não
    // pode, senão suprimiria os próprios alertas de abandono.
    function nutriOnlyKeys() {
      return ['riskOverride'];
    }
    function createsServerOnlyFields() {
      return request.resource.data.keys().hasAny(serverOnlyKeys());
    }
    // affectedKeys() só lista o que MUDOU: regravar o mesmo valor é permitido.
    function updatesServerOnlyFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(serverOnlyKeys());
    }
    // O paciente gravando o próprio doc: bloqueia os campos de servidor E os do nutri.
    function patientCreatesRestrictedFields() {
      return request.resource.data.keys().hasAny(serverOnlyKeys().concat(nutriOnlyKeys()));
    }
    function patientUpdatesRestrictedFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(serverOnlyKeys().concat(nutriOnlyKeys()));
    }

    match /users/{userId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && !createsServerOnlyFields();
      allow update: if request.auth != null && request.auth.uid == userId
        && !updatesServerOnlyFields();
    }

    match /patients/{patientId} {
      // Paciente pode ler, criar e atualizar o próprio doc. As guardas de
      // OTP/phone_verified foram removidas em 28/08/2026 junto com o fluxo de
      // verificação de telefone por SMS (o /start do Telegram já prova posse
      // da conta) - nenhum código lê/escreve esses campos mais.
      allow read: if request.auth != null && request.auth.uid == patientId;
      allow create: if request.auth != null && request.auth.uid == patientId
        && !patientCreatesRestrictedFields();
      allow update: if request.auth != null && request.auth.uid == patientId
        && !patientUpdatesRestrictedFields();

      // Nutricionista dono pode ler, atualizar, criar e deletar seus pacientes.
      allow read, delete: if request.auth != null
        && resource.data.nutricionista_id == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.nutricionista_id == request.auth.uid
        && !updatesServerOnlyFields();
      allow create: if request.auth != null
        && request.resource.data.nutricionista_id == request.auth.uid
        && !createsServerOnlyFields();

      // Paciente novo pode ler o documento temporário gerado pelo nutri antes de ter conta (ID atua como token de convite)
      allow read: if resource.data.status == 'inativo';
      // Qualquer usuário autenticado pode apagar uma ficha provisória ainda
      // não reivindicada (status 'inativo'). Antes exigia uid == patientId,
      // mas o ID da ficha é aleatório (addDoc), nunca igual ao uid do paciente
      // que se cadastra — então o delete SEMPRE falhava e a ficha virava órfã
      // em todo convite (ver backlog.md "Cadastro duplicado"). Superfície de
      // abuso: baixa (IDs não adivinháveis, docs transitórios).
      allow delete: if request.auth != null
        && resource.data.status == 'inativo';
    }

    match /appointments/{apptId} {
      allow read, update, delete: if request.auth != null
        && resource.data.nutricionista_id == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.nutricionista_id == request.auth.uid;

      // Paciente terminando o cadastro via link de convite (?vincular=ID)
      // precisa migrar patientId do placeholder temporário pro seu próprio
      // uid, senão a consulta fica órfã quando o placeholder é deletado.
      // Só permite trocar o campo patientId (nada mais), só pra apontar pro
      // próprio uid do requisitante, e só quando o patientId atual ainda é
      // um placeholder não reivindicado (status 'inativo') — assim não dá
      // pra sequestrar o agendamento de um paciente já ativo.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['patientId'])
        && request.resource.data.patientId == request.auth.uid
        && get(/databases/$(database)/documents/patients/$(resource.data.patientId)).data.status == 'inativo';
    }

    match /dietTemplates/{templateId} {
      allow read, update, delete: if request.auth != null
        && resource.data.nutricionista_id == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.nutricionista_id == request.auth.uid;
    }

    match /recipes/{recipeId} {
      allow read, update, delete: if request.auth != null
        && resource.data.nutricionista_id == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.nutricionista_id == request.auth.uid;
    }

  }
}
