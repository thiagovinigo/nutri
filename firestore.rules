rules_version = '2';

// Regras de segurança do Firestore para o Vytal.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /patients/{patientId} {
      // Paciente pode ler, criar e atualizar seu próprio doc
      allow read, create: if request.auth != null && request.auth.uid == patientId;

      // Update do próprio paciente: liberado, EXCETO nos campos de verificação
      // de telefone via WhatsApp (ver .claude/prds/verificacao-telefone-whatsapp.prd.md).
      // Só o backend (Admin SDK, que ignora estas regras) pode gravar o código OTP
      // e confirmar phone_verified = true - senão o paciente forjaria a verificação
      // direto pelo client SDK, anulando o propósito da feature.
      allow update: if request.auth != null && request.auth.uid == patientId
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['phone_otp_hash', 'phone_otp_expires', 'phone_otp_attempts', 'phone_otp_sent_at'])
        // phone_verified só pode ser tocado pelo client para desligar (false),
        // nunca para ligar (true) - isso é exclusivo do Admin SDK no backend.
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['phone_verified'])
          || request.resource.data.phone_verified == false
        )
        // Trocar o número de telefone sem re-verificar deve sempre derrubar o
        // status de verificado no mesmo write, nunca manter true "de graça".
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['phone'])
          || request.resource.data.phone_verified == false
        );
      
      // Nutricionista dono pode ler, atualizar, criar, deletar - MAS com a
      // mesma restrição do paciente acima nos campos de verificação de
      // telefone: só o backend (Admin SDK) pode confirmar phone_verified.
      // Sem isso, o nutricionista (ou uma conta comprometida) conseguia
      // burlar o OTP direto pelo client SDK, setando phone_verified=true
      // manualmente (achado HIGH da auditoria de segurança de 11/08/2026).
      allow read, delete: if request.auth != null
        && resource.data.nutricionista_id == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.nutricionista_id == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['phone_otp_hash', 'phone_otp_expires', 'phone_otp_attempts', 'phone_otp_sent_at'])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['phone_verified'])
          || request.resource.data.phone_verified == false
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['phone'])
          || request.resource.data.phone_verified == false
        );
      allow create: if request.auth != null
        && request.resource.data.nutricionista_id == request.auth.uid;

      // Paciente novo pode ler o documento temporário gerado pelo nutri antes de ter conta (ID atua como token de convite)
      allow read: if resource.data.status == 'inativo';
      // Só o próprio paciente reivindicando o convite (uid == patientId) pode apagar o placeholder,
      // nunca outro usuário autenticado qualquer
      allow delete: if request.auth != null
        && request.auth.uid == patientId
        && resource.data.status == 'inativo';
    }

    match /appointments/{apptId} {
      allow read, update, delete: if request.auth != null
        && resource.data.nutricionista_id == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.nutricionista_id == request.auth.uid;

      // Paciente terminando o cadastro via link de convite (?vincular=ID)
      // precisa migrar patientId do placeholder temporário pro seu próprio
      // uid, senão a consulta fica órfã quando o placeholder é deletado.
      // Só permite trocar o campo patientId (nada mais), só pra apontar pro
      // próprio uid do requisitante, e só quando o patientId atual ainda é
      // um placeholder não reivindicado (status 'inativo') — assim não dá
      // pra sequestrar o agendamento de um paciente já ativo.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['patientId'])
        && request.resource.data.patientId == request.auth.uid
        && get(/databases/$(database)/documents/patients/$(resource.data.patientId)).data.status == 'inativo';
    }

    match /dietTemplates/{templateId} {
      allow read, update, delete: if request.auth != null
        && resource.data.nutricionista_id == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.nutricionista_id == request.auth.uid;
    }

    match /recipes/{recipeId} {
      allow read, update, delete: if request.auth != null
        && resource.data.nutricionista_id == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.nutricionista_id == request.auth.uid;
    }

  }
}
