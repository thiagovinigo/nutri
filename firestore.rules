rules_version = '2';

// Regras de segurança do Firestore para o Vytal.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /patients/{patientId} {
      // Paciente pode ler, criar e atualizar o próprio doc. As guardas de
      // OTP/phone_verified foram removidas em 28/08/2026 junto com o fluxo de
      // verificação de telefone por SMS (o /start do Telegram já prova posse
      // da conta) - nenhum código lê/escreve esses campos mais.
      allow read, create, update: if request.auth != null && request.auth.uid == patientId;

      // Nutricionista dono pode ler, atualizar, criar e deletar seus pacientes.
      allow read, update, delete: if request.auth != null
        && resource.data.nutricionista_id == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.nutricionista_id == request.auth.uid;

      // Paciente novo pode ler o documento temporário gerado pelo nutri antes de ter conta (ID atua como token de convite)
      allow read: if resource.data.status == 'inativo';
      // Qualquer usuário autenticado pode apagar uma ficha provisória ainda
      // não reivindicada (status 'inativo'). Antes exigia uid == patientId,
      // mas o ID da ficha é aleatório (addDoc), nunca igual ao uid do paciente
      // que se cadastra — então o delete SEMPRE falhava e a ficha virava órfã
      // em todo convite (ver backlog.md "Cadastro duplicado"). Superfície de
      // abuso: baixa (IDs não adivinháveis, docs transitórios).
      allow delete: if request.auth != null
        && resource.data.status == 'inativo';
    }

    match /appointments/{apptId} {
      allow read, update, delete: if request.auth != null
        && resource.data.nutricionista_id == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.nutricionista_id == request.auth.uid;

      // Paciente terminando o cadastro via link de convite (?vincular=ID)
      // precisa migrar patientId do placeholder temporário pro seu próprio
      // uid, senão a consulta fica órfã quando o placeholder é deletado.
      // Só permite trocar o campo patientId (nada mais), só pra apontar pro
      // próprio uid do requisitante, e só quando o patientId atual ainda é
      // um placeholder não reivindicado (status 'inativo') — assim não dá
      // pra sequestrar o agendamento de um paciente já ativo.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['patientId'])
        && request.resource.data.patientId == request.auth.uid
        && get(/databases/$(database)/documents/patients/$(resource.data.patientId)).data.status == 'inativo';
    }

    match /dietTemplates/{templateId} {
      allow read, update, delete: if request.auth != null
        && resource.data.nutricionista_id == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.nutricionista_id == request.auth.uid;
    }

    match /recipes/{recipeId} {
      allow read, update, delete: if request.auth != null
        && resource.data.nutricionista_id == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.nutricionista_id == request.auth.uid;
    }

  }
}
