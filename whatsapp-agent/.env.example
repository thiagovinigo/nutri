# LLM (OpenAI): agente, visão de imagem/PDF e transcrição de áudio (Whisper)
OPENAI_API_KEY=
MODELO_AGENTE=openai:gpt-4o-mini
MODELO_MIDIA=gpt-4o-mini

# WAHA (WhatsApp)
WAHA_URL=http://localhost:3000
WAHA_API_KEY=
WAHA_DASHBOARD_USERNAME=
WAHA_DASHBOARD_PASSWORD=
# Segredo opcional: se preenchido, o webhook só aceita requisições assinadas pelo WAHA
WAHA_WEBHOOK_HMAC_KEY=

# Segundos de espera pelo cliente terminar de digitar
BUFFER_SEGUNDOS=2
